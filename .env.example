# =====================================================================
# Grupo Ricartti — variables de entorno
# ---------------------------------------------------------------------
# 1. Copia este archivo como ".env" en la raíz del proyecto.
# 2. Cambia las dos contraseñas marcadas con "CAMBIAR".
# .env está en .gitignore: NUNCA lo subas al repositorio.
# Los valores de este archivo son ejemplos, no credenciales reales.
# Formato: CLAVE=valor, sin comillas ni espacios, comentarios en su
# propia línea.
# =====================================================================

# --- Base de datos: rol de la aplicación (lo usa la API) --------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ricartti
DB_USER=ricartti_app
# CAMBIAR: contraseña del rol de la aplicación (la eliges tú).
DB_PASSWORD=cambia_esta_contrasena_app

# --- Base de datos: superusuario (solo para crear el rol y la base) ---
# Docker:  se crea con esta contraseña la primera vez que arranca.
# Local:   la contraseña de "postgres" que definiste al instalar
#          PostgreSQL. Si la dejas vacía, el script te la pedirá.
DB_ADMIN_USER=postgres
# CAMBIAR
DB_ADMIN_PASSWORD=cambia_esta_contrasena_admin

# Puerto del host donde Docker expone PostgreSQL. Es distinto de 5432
# para no chocar con un PostgreSQL instalado localmente.
DB_DOCKER_HOST_PORT=5433

# --- API --------------------------------------------------------------
ASPNETCORE_ENVIRONMENT=Development
API_PORT=5080
# Carpeta de imágenes. Las rutas relativas se resuelven desde la raíz del repo.
UPLOADS_PATH=uploads
UPLOAD_MAX_BYTES=5242880

# --- Autenticación (sesión con cookie HttpOnly) ----------------------
AUTH_COOKIE_NAME=ricartti_session
# Chrome, Edge y Firefox aceptan cookies "Secure" en http://localhost.
# Ponlo en false solo si tu navegador rechaza la cookie en local.
AUTH_COOKIE_SECURE=true
AUTH_SESSION_IDLE_MINUTES=30
AUTH_SESSION_ABSOLUTE_HOURS=8
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# --- Límite de peticiones (por IP) ------------------------------------
RATE_LIMIT_LOGIN_PERMITS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_FORMS_PERMITS=5
RATE_LIMIT_FORMS_WINDOW_SECONDS=900
RATE_LIMIT_GLOBAL_PERMITS_PER_MINUTE=120

# --- Docker -----------------------------------------------------------
# Puerto del sitio cuando se ejecuta con Docker: http://localhost:8080
WEB_PORT=8080
# Ruta al repositorio GR-frontend, relativa a esta carpeta.
# Por defecto se espera clonado junto a GR-backend.
FRONTEND_PATH=../GR-frontend
